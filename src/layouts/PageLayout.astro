---
import BaseLayout from "./BaseLayout.astro";
export interface Props {
  title: string;
  description?: string;
  h1: string;
  faq?: { q: string; a: string }[];
  crumb?: { label: string; href: string }[];
  noindex?: boolean;
}
const { title, description, h1, faq = [], crumb = [], noindex = false } = Astro.props;
---
<BaseLayout title={title} description={description} faq={faq} noindex={noindex}>
  <section class="hero">
    <div class="wrap">
      {crumb.length > 0 && (
        <p class="crumb">
          {crumb.map((c, i) => (
            <>
              {i > 0 && <span> / </span>}
              <a href={c.href}>{c.label}</a>
            </>
          ))}
        </p>
      )}
      <h1>{h1}</h1>
      {description && <p>{description}</p>}
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <slot />
      <slot name="after" />
    </div>
  </section>
</BaseLayout>
