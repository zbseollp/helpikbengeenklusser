    <button class="backtotop" type="button" aria-label={"Terug naar boven"} data-backtotop>
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"
        ><path d="M9 14V4M4 8l5-4 5 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
        stroke-linejoin="round"/></svg>
    </button>

    <script>
      // mobile menu
      const t = document.querySelector(".menu-toggle");
      const n = document.getElementById("mobile-nav");
      t?.addEventListener("click", () => {
        const open = n?.classList.toggle("open");
        t.setAttribute("aria-expanded", open ? "true" : "false");
      });

      // desktop mega menu: hover on pointer devices, click/keyboard everywhere
      document.querySelectorAll("[data-nav-group]").forEach((item) => {
        const link = item.querySelector(".nav-link");
        let timer;
        const open = (v) => {
          item.dataset.open = v ? "true" : "false";
          link?.setAttribute("aria-expanded", v ? "true" : "false");
        };
        item.addEventListener("mouseenter", () => { clearTimeout(timer); open(true); });
        item.addEventListener("mouseleave", () => { timer = setTimeout(() => open(false), 120); });
        item.addEventListener("focusin", () => open(true));
        item.addEventListener("focusout", (e) => {
          if (!item.contains(e.relatedTarget)) open(false);
        });
        link?.addEventListener("keydown", (e) => {
          if (e.key === "Escape") { open(false); link.blur(); }
        });
      });

      // back to top
      const bt = document.querySelector("[data-backtotop]");
      const onScroll = () => bt?.classList.toggle("show", window.scrollY > 900);
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
      bt?.addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: "smooth" })
      );

      // reading progress (only where a progress bar is present)
      const pb = document.querySelector("[data-progress]");
      if (pb) {
        const upd = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          pb.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + "%";
        };
        window.addEventListener("scroll", upd, { passive: true });
        window.addEventListener("resize", upd);
        upd();
      }
    </script>
