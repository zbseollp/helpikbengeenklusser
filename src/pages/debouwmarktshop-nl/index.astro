const segments = [["prose", "<div class=\"store-card\"><div class=\"store-mark\"><img src=\"/img/logo-ee1f4392dddd03.svg\" alt=\"Debouwmarktshop.nl\" loading=\"lazy\" /></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>Industrieweg 5F</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31732010005\">+31 73 201 0005</a></dd></div><div><dt>Website</dt><dd><a href=\"http://www.debouwmarktshop.nl/\" target=\"_blank\" rel=\"nofollow noopener\">debouwmarktshop.nl</a></dd></div></dl></div>\n<p>Debouwmarktshop.nl is een Bouwmarkt gelegen aan Industrieweg 5F in Vught.</p>\n<h3 id=\"meer-informatie-over-debouwmarktshop-nl-in-vught\">Meer informatie over Debouwmarktshop.nl in Vught</h3>\n<p>Debouwmarktshop.nl is een Bouwmarkt gelegen in Vught op Industrieweg 5F.</p>\n<p>Debouwmarktshop.nl in Vught is een grote Bouwmarkt met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een Bouwmarkt in de buurt van Vught? Dan ben je bij Debouwmarktshop.nl op de juiste plek. Bij Debouwmarktshop.nl kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met Debouwmarktshop.nldoor ze telefonisch te bereiken op: 31 73 201 0005 of bekijk de website door op de link hieronder te klikken.</p>\n<p><a href=\"http://www.debouwmarktshop.nl/\" target=\"_blank\" rel=\"nofollow noopener\">http://www.debouwmarktshop.nl/</a></p>\n<p>Wil je graag een prettige Bouwmarkt? Kom vandaag nog langs bij Debouwmarktshop.nl.</p>\n<p>Hoe kom je bij Debouwmarktshop.nl? Open direct de <a href=\"https://www.google.com/maps/place/Debouwmarktshop.nl/@51.6462976,5.292918,17z/data=!3m1!4b1!4m6!3m5!1s0x47c6e935ac7b0e9d:0x6ef942b9bc8801ce!8m2!3d51.6462976!4d5.292918!16s%2Fg%2F1tf9xn25?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je Debouwmarktshop.nl het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>Debouwmarktshop.nl</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/bouwcenter-logus-de-hoop-terneuzen/\">Bouwcenter Logus-De Hoop Terneuzen</a></li><li><a href=\"/bouwcenter-logus-de-hoop-vlissingen/\">Bouwcenter Logus-De Hoop Vlissingen</a></li><li><a href=\"/gamma-bouwmarkt-deventer/\">GAMMA bouwmarkt Deventer</a></li><li><a href=\"/gamma-bouwmarkt-oss/\">GAMMA bouwmarkt Oss</a></li><li><a href=\"/hornbach-zaandam/\">HORNBACH Zaandam</a></li><li><a href=\"/hubo-bouwmarkt-groenlo/\">Hubo bouwmarkt Groenlo</a></li><li><a href=\"/hubo-bouwmarkt-serooskerke/\">Hubo bouwmarkt Serooskerke</a></li><li><a href=\"/noort-bv-keukens-sanitair-bouwmaterialen-van/\">Noort BV Keukens Sanitair &amp; Bouwmaterialen Van</a></li></ul>"]];
