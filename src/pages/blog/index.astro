---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout title={"Blog - helpikbengeenklusser"} description={"Blog"}>
  <section class="hero">
    <div class="wrap">
      <p class="crumb"><a href="/">Home</a></p>
      <h1>{"Blog"}</h1>
      <p>{"Blog"}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="grid">
        {posts.map((post) => (
          <a class="card" href={`/${post.id}/`}>
            <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
              {post.data.pubDate.toLocaleDateString("nl-NL", {
                day: "numeric",
                month: "long",
                year: "numeric",
              })}
            </time>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
