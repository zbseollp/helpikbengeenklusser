---
import PageLayout from "../../layouts/PageLayout.astro";
const segments = [["prose", "<div class=\"store-card\"><div class=\"store-mark\"><img src=\"/img/logo-3aee4972ab2b29.png\" alt=\"Tegelcentrum &amp; sanitair TCS\" loading=\"lazy\" /></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>Coolhaven 130</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31102108068\">+31 10 210 8068</a></dd></div><div><dt>Website</dt><dd><a href=\"https://www.tcs-sanitair.nl/\" target=\"_blank\" rel=\"nofollow noopener\">tcs-sanitair.nl</a></dd></div></dl></div>\n<p>Tegelcentrum &amp; sanitair TCS is een Bouwmarkt gelegen aan Coolhaven 130 in Rotterdam.</p>\n<h3 id=\"meer-informatie-over-tegelcentrum-sanitair-tcs-in-rotterdam\">Meer informatie over Tegelcentrum &amp; sanitair TCS in Rotterdam</h3>\n<p>Tegelcentrum &amp; sanitair TCS is een Bouwmarkt gelegen in Rotterdam op Coolhaven 130.</p>\n<p>Tegelcentrum &amp; sanitair TCS in Rotterdam is een grote Bouwmarkt met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een Bouwmarkt in de buurt van Rotterdam? Dan ben je bij Tegelcentrum &amp; sanitair TCS op de juiste plek. Bij Tegelcentrum &amp; sanitair TCS kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met Tegelcentrum &amp; sanitair TCSdoor ze telefonisch te bereiken op: 31 10 210 8068 of bekijk de website door op de link hieronder te klikken.</p>\n<p><a href=\"https://www.tcs-sanitair.nl/\" target=\"_blank\" rel=\"nofollow noopener\">https://www.tcs-sanitair.nl/</a></p>\n<p>Wil je graag een prettige Bouwmarkt? Kom vandaag nog langs bij Tegelcentrum &amp; sanitair TCS.</p>\n<p>Hoe kom je bij Tegelcentrum &amp; sanitair TCS? Open direct de <a href=\"https://www.google.com/maps/place/Tegelcentrum+%26+sanitair+TCS/@51.9074146,4.456354,17z/data=!3m1!4b1!4m6!3m5!1s0x47c4349188d0cfa9:0x7bc608ed2a6e4f1!8m2!3d51.9074146!4d4.456354!16s%2Fg%2F11fx8yv8md?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je Tegelcentrum &amp; sanitair TCS het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>Tegelcentrum &amp; sanitair TCS</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/bouwcenter-logus-de-hoop-vlissingen/\">Bouwcenter Logus-De Hoop Vlissingen</a></li><li><a href=\"/bouwpartner-sieben-bv-bouw-afbouwmaterialen/\">Bouwpartner Sieben BV Bouw- &amp; Afbouwmaterialen</a></li><li><a href=\"/gamma-bouwmarkt-eindhoven/\">GAMMA bouwmarkt Eindhoven</a></li><li><a href=\"/hubo-bouwmarkt-breda-beverweg-/\">Hubo bouwmarkt Breda (Beverweg)</a></li><li><a href=\"/jansen-super-keukens-bv/\">Jansen Super Keukens BV</a></li><li><a href=\"/karwei-bouwmarkt-eindhoven/\">Karwei bouwmarkt Eindhoven</a></li><li><a href=\"/pontmeyer-alkmaar/\">PontMeyer Alkmaar</a></li><li><a href=\"/praxis-bouwmarkt-vroomshoop/\">Praxis Bouwmarkt Vroomshoop</a></li></ul>"]];
const faq = [];
---
<PageLayout
