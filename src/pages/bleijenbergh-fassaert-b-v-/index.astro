const segments = [["prose", "<div class=\"store-card\"><div class=\"store-mark\"><img src=\"/img/logo-e102acdbd4e194.svg\" alt=\"Bleijenbergh-Fassaert B.V.\" loading=\"lazy\" /></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>Aziëweg 3</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31114312551\">+31 114 312 551</a></dd></div><div><dt>Website</dt><dd><a href=\"https://www.bfhulst.nl/\" target=\"_blank\" rel=\"nofollow noopener\">bfhulst.nl</a></dd></div></dl></div>\n<p>Bleijenbergh-Fassaert B.V. is een Bouwmarkt gelegen aan Aziëweg 3 in Hulst.</p>\n<h3 id=\"meer-informatie-over-bleijenbergh-fassaert-b-v-in-hulst\">Meer informatie over Bleijenbergh-Fassaert B.V. in Hulst</h3>\n<p>Bleijenbergh-Fassaert B.V. is een Bouwmarkt gelegen in Hulst op Aziëweg 3.</p>\n<p>Bleijenbergh-Fassaert B.V. in Hulst is een grote Bouwmarkt met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een Bouwmarkt in de buurt van Hulst? Dan ben je bij Bleijenbergh-Fassaert B.V. op de juiste plek. Bij Bleijenbergh-Fassaert B.V. kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met Bleijenbergh-Fassaert B.V.door ze telefonisch te bereiken op: 31 114 312 551 of bekijk de website door op de link hieronder te klikken.</p>\n<p><a href=\"https://www.bfhulst.nl/\" target=\"_blank\" rel=\"nofollow noopener\">https://www.bfhulst.nl/</a></p>\n<p>Wil je graag een prettige Bouwmarkt? Kom vandaag nog langs bij Bleijenbergh-Fassaert B.V..</p>\n<p>Hoe kom je bij Bleijenbergh-Fassaert B.V.? Open direct de <a href=\"https://www.google.com/maps/place/Bleijenbergh-Fassaert+B.V./@51.2698879,4.0414357,17z/data=!3m1!4b1!4m6!3m5!1s0x47c3878c4f74900b:0xb51d0b93d3c079c8!8m2!3d51.2698879!4d4.0414357!16s%2Fg%2F1whdhhsr?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je Bleijenbergh-Fassaert B.V. het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>Bleijenbergh-Fassaert B.V.</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/bmn-bouwmaterialen-numansdorp/\">BMN Bouwmaterialen Numansdorp</a></li><li><a href=\"/bouwpartner-heurkens-bouwmaterialen/\">BouwPartner Heurkens Bouwmaterialen</a></li><li><a href=\"/gamma-bouwmarkt-veendam/\">GAMMA bouwmarkt Veendam</a></li><li><a href=\"/hubo-bouwmarkt-osw-veghel/\">Hubo bouwmarkt Osw Veghel</a></li><li><a href=\"/karwei-bouwmarkt-beverwijk/\">Karwei bouwmarkt Beverwijk</a></li><li><a href=\"/karwei-bouwmarkt-den-bosch-west/\">Karwei bouwmarkt Den Bosch-West</a></li><li><a href=\"/na-tex-bouwgroothandel/\">Na-tex Bouwgroothandel</a></li><li><a href=\"/raab-karcher-middelburg/\">Raab Karcher Middelburg</a></li></ul>"]];
