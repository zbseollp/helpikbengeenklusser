---
import PageLayout from "../../layouts/PageLayout.astro";
const segments = [["prose", "<h2 id=\"bekijk-ook-andere-bouwstofzuigers\">Bekijk ook andere bouwstofzuigers</h2>"]];
const faq = [];
---
<PageLayout
  title={"Bouwstofzuiger"}
  description={"Stofzuiger nodig voor het opzuigen van bouwafval? Ontdek hier meer over."}
  h1={"Bouwstofzuiger"}
  noindex={true}
  captcha={false}
  faq={faq}
  crumb={[{ label: "Home", href: "/" }]}
>
  {segments.map((s) => (
    <div class={s[0] === "prose" ? "prose" : "seg-full"} set:html={s[1]} />
  ))}
</PageLayout>
