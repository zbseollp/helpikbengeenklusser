---
import PageLayout from "../../layouts/PageLayout.astro";
const segments = [["prose", "<p>In de categorie frezen en zagen vind je diverse machines voor het frezen en voor het zagen. Denk aan een bovenfrees, een freesmachine, een kettingzaag, een lamellenfrees, een zaagmachine en nog veel meer. Bekijk al onze breedvoerige recensies over de machines onder categorie frezen en zagen.</p>\n<ul><li><a href=\"/beste-afkortzaag/\">Beste afkortzaag</a></li><li><a href=\"/beste-bovenfrees/\">Beste bovenfrees</a></li><li><a href=\"/beste-cirkelzaag/\">Beste cirkelzaag</a></li><li><a href=\"/beste-decoupeerzaag/\">Beste decoupeerzaag</a></li><li><a href=\"/beste-draaibank/\">Beste draaibank</a></li><li><a href=\"/beste-figuurzaagmachine/\">Beste figuurzaagmachine</a></li><li><a href=\"/beste-freesmachine/\">Beste freesmachine</a></li><li><a href=\"/beste-gatenzaag/\">Beste gatenzaag</a></li><li><a href=\"/beste-handcirkelzaag/\">Beste handcirkelzaag</a></li><li><a href=\"/beste-houtbrander/\">Beste houtbrander</a></li><li><a href=\"/beste-invalzaag/\">Beste invalzaag</a></li><li><a href=\"/beste-kantenfrees/\">Beste kantenfrees</a></li><li><a href=\"/beste-kettingzaag/\">Beste kettingzaag</a></li><li><a href=\"/beste-kettingzaagslijper/\">Beste kettingzaagslijper</a></li><li><a href=\"/beste-lamellenfrees/\">Beste lamellenfrees</a></li><li><a href=\"/beste-lintzaag/\">Beste lintzaag</a></li><li><a href=\"/beste-muurfrees/\">Beste muurfrees</a></li><li><a href=\"/beste-profielfrees/\">Beste profielfrees</a></li><li><a href=\"/beste-reciprozaag/\">Beste reciprozaag</a></li><li><a href=\"/beste-steenboor/\">Beste steenboor</a></li><li><a href=\"/beste-tegelkruisjes/\">Beste tegelkruisjes</a></li><li><a href=\"/beste-tegelsnijder/\">Beste tegelsnijder</a></li><li><a href=\"/beste-verstekzaag/\">Beste verstekzaag</a></li><li><a href=\"/beste-wiggen/\">Beste wiggen</a></li><li><a href=\"/beste-zaagmachine/\">Beste zaagmachine</a></li><li><a href=\"/beste-zaagtafel/\">Beste zaagtafel</a></li></ul>"]];
const faq = [];
---
<PageLayout
  title={"Frezen en zagen - helpikbengeenklusser"}
  description={"In de categorie frezen en zagen vind je diverse machines voor het frezen en voor het zagen. Denk aan een bovenfrees, een freesmachine, een kettingzaag, een lamellenfrees, een zaagmachine en nog veel meer. Bekijk al onze breedvoerige recensies over de machines onder categorie frezen en zagen."}
  h1={"Frezen en zagen"}
  noindex={false}
  captcha={false}
  faq={faq}
  crumb={[{ label: "Home", href: "/" }]}
>
  {segments.map((s) => (
    <div class={s[0] === "prose" ? "prose" : "seg-full"} set:html={s[1]} />
  ))}
</PageLayout>
