const segments = [["prose", "<div class=\"store-card\"><div class=\"store-mark\"><span class=\"wordmark\">EikenhoutShop.nl</span></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>Buorren 1</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31517764000\">+31 517 764 000</a></dd></div></dl></div>\n<p>EikenhoutShop.nl is een Bouwmarkt gelegen aan Buorren 1 in Skingen.</p>\n<h3 id=\"meer-informatie-over-eikenhoutshop-nl-in-skingen\">Meer informatie over EikenhoutShop.nl in Skingen</h3>\n<p>EikenhoutShop.nl is een Bouwmarkt gelegen in Skingen op Buorren 1.</p>\n<p>EikenhoutShop.nl in Skingen is een grote Bouwmarkt met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een Bouwmarkt in de buurt van Skingen? Dan ben je bij EikenhoutShop.nl op de juiste plek. Bij EikenhoutShop.nl kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met EikenhoutShop.nldoor ze telefonisch te bereiken op: 31 517 764 000 of bekijk de website door op de link hieronder te klikken.</p>\n<p>Wil je graag een prettige Bouwmarkt? Kom vandaag nog langs bij EikenhoutShop.nl.</p>\n<p>Hoe kom je bij EikenhoutShop.nl? Open direct de <a href=\"https://www.google.com/maps/place/EikenhoutShop.nl/@53.2007334,5.6150248,17z/data=!3m1!4b1!4m6!3m5!1s0x47c8e3a43c240001:0xa88338e7699ad1b5!8m2!3d53.2007334!4d5.6150248!16s%2Fg%2F11hyzyx78v?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je EikenhoutShop.nl het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>EikenhoutShop.nl</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/bmn-bouwmaterialen-purmerend/\">BMN Bouwmaterialen Purmerend</a></li><li><a href=\"/bouwmarkt-egmond/\">Bouwmarkt Egmond</a></li><li><a href=\"/de-voordeelmarkt-alkmaar/\">De Voordeelmarkt Alkmaar</a></li><li><a href=\"/hubo-bouwmarkt-werkendam/\">Hubo bouwmarkt Werkendam</a></li><li><a href=\"/kluswijs-klundert/\">KlusWijs Klundert</a></li><li><a href=\"/pontmeyer-den-bosch/\">PontMeyer Den Bosch</a></li><li><a href=\"/raab-karcher-emmeloord/\">Raab Karcher Emmeloord</a></li><li><a href=\"/van-buuren-bouwmarkt/\">Van Buuren Bouwmarkt</a></li></ul>"]];
const faq = [];
