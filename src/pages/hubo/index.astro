import PageLayout from "../../layouts/PageLayout.astro";
const html = "<div class=\"store-card\"><div class=\"store-mark\"><img src=\"/img/logo-168473e54cbec5.png\" alt=\"Hubo\" loading=\"lazy\" /></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>Sint Willibrordstraat 15</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31135331612\">+31 13 533 1612</a></dd></div><div><dt>Website</dt><dd><a href=\"https://www.hubo.nl/berkel-enschot\" target=\"_blank\" rel=\"nofollow noopener\">hubo.nl/berkel-enschot</a></dd></div></dl></div>\n<p>Hubo is een Bouwmarkt gelegen aan Sint Willibrordstraat 15 in Berkel-Enschot.</p>\n<h3 id=\"meer-informatie-over-hubo-in-berkel-enschot\">Meer informatie over Hubo in Berkel-Enschot</h3>\n<p>Hubo is een Bouwmarkt gelegen in Berkel-Enschot op Sint Willibrordstraat 15.</p>\n<p>Hubo in Berkel-Enschot is een grote Bouwmarkt met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een Bouwmarkt in de buurt van Berkel-Enschot? Dan ben je bij Hubo op de juiste plek. Bij Hubo kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met Hubodoor ze telefonisch te bereiken op: 31 13 533 1612 of bekijk de website door op de link hieronder te klikken.</p>\n<p><a href=\"https://www.hubo.nl/berkel-enschot?utm_source=google&amp;utm_medium=organic&amp;utm_campaign=gmb-website\" target=\"_blank\" rel=\"nofollow noopener\">https://www.hubo.nl/berkel-enschot?utm_source=google&amp;utm_medium=organic&amp;utm_campaign=gmb-website</a></p>\n<p>Wil je graag een prettige Bouwmarkt? Kom vandaag nog langs bij Hubo.</p>\n<p>Hoe kom je bij Hubo? Open direct de <a href=\"https://www.google.com/maps/place/Hubo/@51.5894566,5.1420581,17z/data=!3m1!4b1!4m6!3m5!1s0x47c69549731118b7:0x1ed89f8fdf70089f!8m2!3d51.5894566!4d5.1420581!16s%2Fg%2F1wn_59wb?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je Hubo het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>Hubo</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/berensen-bouwmarkt/\">Berensen Bouwmarkt</a></li><li><a href=\"/bouwmaat-arnhem/\">Bouwmaat Arnhem</a></li><li><a href=\"/bouwmarkt/\">Bouwmarkt</a></li><li><a href=\"/gamma-bouwmarkt-delft/\">GAMMA bouwmarkt Delft</a></li><li><a href=\"/gamma-bouwmarkt-scheveningen-den-haag/\">GAMMA bouwmarkt Scheveningen, Den Haag</a></li><li><a href=\"/hubo-bouwmarkt-castricum/\">Hubo bouwmarkt Castricum</a></li><li><a href=\"/praxis-bouwmarkt-dordrecht/\">Praxis Bouwmarkt Dordrecht</a></li><li><a href=\"/toolstation-utrecht/\">Toolstation Utrecht</a></li></ul>";
const faq = [];
