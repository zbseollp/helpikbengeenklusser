---
import PageLayout from "../../layouts/PageLayout.astro";
const html = "<p>Ben je het antwoord op je vraag nog niet tegen gekomen? Dan kun je hier makkelijk en snel je vraag insturen. We zullen zo snel mogelijk met een antwoord komen.</p>";
const faq = [];
---
<PageLayout
  title={"Stel je Vraag - Helpikbengeenklusser.nl"}
  description={"Hier kun je gemakkelijk en snel je vraag stellen wanneer je deze nog niet op onze website hebt kunnen vinden."}
  h1={"Stel een Vraag"}
  faq={faq}
  crumb={[{ label: "Home", href: "/" }]}
>
  <Fragment set:html={html} />
</PageLayout>
