---
import PageLayout from "../../layouts/PageLayout.astro";
const segments = [["prose", "<h2 id=\"bekijk-ook-andere-gereedschapsets\">Bekijk ook andere gereedschapsets</h2>"]];
const faq = [];
---
<PageLayout
  title={"Gereedschapset"}
  description={"Gereedschapset aanschaffen? Bekijk hier wat allemaal voor je te bieden heeft."}
  h1={"Gereedschapset"}
  noindex={true}
  faq={faq}
  crumb={[{ label: "Home", href: "/" }]}
>
  {segments.map((s) => (
    <div class={s[0] === "prose" ? "prose" : "seg-full"} set:html={s[1]} />
  ))}
</PageLayout>
