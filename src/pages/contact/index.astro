---
import PageLayout from "../../layouts/PageLayout.astro";
const segments = [["prose", "<p>Wil je in contact komen met ons team? Dan kun je dat doen door onderstaand formulier in te vullen. Ook kun je ons volgen op een van onze socialmediaplatforms.</p>\n<img src=\"/img/59f743106c59e045.png\" alt=\"\" loading=\"lazy\" />"], ["prose", "<form class=\"form\" action=\"https://api.web3forms.com/submit\" method=\"POST\" data-contact-form>\n<input type=\"hidden\" name=\"access_key\" value=\"281f477d-7744-407d-9b6a-9b8d9c6abe3c\" />\n<input type=\"hidden\" name=\"subject\" value=\"Nieuw bericht via helpikbengeenklusser.nl\" />\n<input type=\"hidden\" name=\"from_name\" value=\"HelpIkBenGeenKlusser\" />\n<label class=\"hp\" aria-hidden=\"true\">Bot<input type=\"checkbox\" name=\"botcheck\" tabindex=\"-1\" autocomplete=\"off\" /></label>\n<h2 style=\"margin-top:0\">Stuur ons een bericht</h2>\n<div class=\"form-row form-2\">\n<div class=\"field\">\n<label for=\"cf-name\">Naam <span class=\"req\" aria-hidden=\"true\">*</span></label>\n<input id=\"cf-name\" name=\"name\" type=\"text\" required autocomplete=\"name\" placeholder=\"Je naam\" />\n</div>\n<div class=\"field\">\n<label for=\"cf-email\">E-mailadres <span class=\"req\" aria-hidden=\"true\">*</span></label>\n<input id=\"cf-email\" name=\"email\" type=\"email\" required autocomplete=\"email\" placeholder=\"jij@voorbeeld.nl\" />\n</div>\n</div>\n<div class=\"field\">\n<label for=\"cf-message\">Bericht <span class=\"req\" aria-hidden=\"true\">*</span></label>\n<textarea id=\"cf-message\" name=\"message\" rows=\"6\" required placeholder=\"Waar kunnen we je mee helpen?\"></textarea>\n</div>\n<button class=\"btn\" type=\"submit\" data-send=\"Versturen\" data-sending=\"Bezig met versturen...\">Versturen</button>\n<p class=\"form-status\" role=\"status\" aria-live=\"polite\"></p>\n<p class=\"form-note\">We gebruiken je gegevens alleen om je bericht te beantwoorden.</p>\n</form>"]];
const faq = [];
---
<PageLayout
  title={"Contact - helpikbengeenklusser"}
  description={"Contact Wil je in contact komen met ons team? Dan kun je dat doen door onderstaand formulier in te vullen. Ook kun je ons volgen op een van onze socialmediaplatforms. Facebook Instagram Twitter Youtube Your name Your email address Message"}
  h1={"Contact"}
  noindex={false}
  faq={faq}
  crumb={[{ label: "Home", href: "/" }]}
>
  {segments.map((s) => (
    <div class={s[0] === "prose" ? "prose" : "seg-full"} set:html={s[1]} />
  ))}
</PageLayout>
