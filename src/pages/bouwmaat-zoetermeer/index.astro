const segments = [["prose", "<div class=\"store-card\"><div class=\"store-mark\"><img src=\"/img/logo-e60997fc46dbdb.svg\" alt=\"Bouwmaat Zoetermeer\" loading=\"lazy\" /></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>Koperstraat 3</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31793634141\">+31 79 363 4141</a></dd></div><div><dt>Website</dt><dd><a href=\"https://www.bouwmaat.nl/vestigingen/bouwmaat-zoetermeer\" target=\"_blank\" rel=\"nofollow noopener\">bouwmaat.nl/vestigingen/bouwmaat-zoetermeer</a></dd></div></dl></div>\n<p>Bouwmaat Zoetermeer is een Leverancier van bouwmaterialen gelegen aan Koperstraat 3 in Zoetermeer.</p>\n<h3 id=\"meer-informatie-over-bouwmaat-zoetermeer-in-zoetermeer\">Meer informatie over Bouwmaat Zoetermeer in Zoetermeer</h3>\n<p>Bouwmaat Zoetermeer is een Leverancier van bouwmaterialen gelegen in Zoetermeer op Koperstraat 3.</p>\n<p>Bouwmaat Zoetermeer in Zoetermeer is een grote Leverancier van bouwmaterialen met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een Leverancier van bouwmaterialen in de buurt van Zoetermeer? Dan ben je bij Bouwmaat Zoetermeer op de juiste plek. Bij Bouwmaat Zoetermeer kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met Bouwmaat Zoetermeerdoor ze telefonisch te bereiken op: 31 79 363 4141 of bekijk de website door op de link hieronder te klikken.</p>\n<p><a href=\"https://www.bouwmaat.nl/vestigingen/bouwmaat-zoetermeer?utm_source=Google&amp;utm_medium=GMB&amp;utm_campaign=lokaal&amp;utm_term=vestigingspagina\" target=\"_blank\" rel=\"nofollow noopener\">https://www.bouwmaat.nl/vestigingen/bouwmaat-zoetermeer?utm_source=Google&amp;utm_medium=GMB&amp;utm_campaign=lokaal&amp;utm_term=vestigingspagina</a></p>\n<p>Wil je graag een prettige Leverancier van bouwmaterialen? Kom vandaag nog langs bij Bouwmaat Zoetermeer.</p>\n<p>Hoe kom je bij Bouwmaat Zoetermeer? Open direct de <a href=\"https://www.google.com/maps/place/Bouwmaat+Zoetermeer/@52.0389483,4.5068137,17z/data=!3m1!4b1!4m6!3m5!1s0x47c5ceb7a65fe9e7:0x527fd830d3b8408c!8m2!3d52.0389483!4d4.5068137!16s%2Fg%2F1trsx5gj?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je Bouwmaat Zoetermeer het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>Bouwmaat Zoetermeer</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/gamma-bouwmarkt-megastores-den-haag/\">GAMMA bouwmarkt MegaStores Den Haag</a></li><li><a href=\"/hubo-bouwmarkt-mierlo/\">Hubo bouwmarkt Mierlo</a></li><li><a href=\"/karwei-bouwmarkt-amsterdam-spaklerweg/\">KARWEI bouwmarkt Amsterdam-Spaklerweg</a></li><li><a href=\"/karwei-bouwmarkt-etten-leur/\">Karwei bouwmarkt Etten-Leur</a></li><li><a href=\"/karwei-bouwmarkt-tilburg-reeshof/\">Karwei bouwmarkt Tilburg-Reeshof</a></li><li><a href=\"/praxis-city-rotterdam-eudokiaplein/\">Praxis City Rotterdam Eudokiaplein</a></li><li><a href=\"/van-schooten-construction-materials/\">Van Schooten Construction Materials</a></li><li><a href=\"/wilfens-bouwmarkt/\">Wilfens Bouwmarkt</a></li></ul>"]];
const faq = [];
