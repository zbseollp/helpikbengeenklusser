---
import PageLayout from "../../layouts/PageLayout.astro";
const segments = [];
const faq = [];
---
<PageLayout
  title={"Bekijk je profiel - Helpikbengeenklusser.nl"}
  description={"Heb je een account op onze website. Neem dan hier een kijkje op je profiel en vind makkelijk alle vragen waar je naar hebt gezocht."}
  h1={"Bekijk je profiel - Helpikbengeenklusser.nl"}
  noindex={false}
  faq={faq}
  crumb={[{ label: "Home", href: "/" }]}
>
  {segments.map((s) => (
    <div class={s[0] === "prose" ? "prose" : "seg-full"} set:html={s[1]} />
  ))}
</PageLayout>
