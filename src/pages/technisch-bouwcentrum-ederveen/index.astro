const segments = [["prose", "<div class=\"store-card\"><div class=\"store-mark\"><span class=\"wordmark\">Technisch Bouwcentrum Ederveen</span></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>Hoofdweg 140</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31318570443\">+31 318 570 443</a></dd></div><div><dt>Website</dt><dd><a href=\"http://www.bouwcentrumederveen.nl/\" target=\"_blank\" rel=\"nofollow noopener\">bouwcentrumederveen.nl</a></dd></div></dl></div>\n<p>Technisch Bouwcentrum Ederveen is een IJzerhandel gelegen aan Hoofdweg 140 in Ederveen.</p>\n<h3 id=\"meer-informatie-over-technisch-bouwcentrum-ederveen-in-ederv\">Meer informatie over Technisch Bouwcentrum Ederveen in Ederveen</h3>\n<p>Technisch Bouwcentrum Ederveen is een IJzerhandel gelegen in Ederveen op Hoofdweg 140.</p>\n<p>Technisch Bouwcentrum Ederveen in Ederveen is een grote IJzerhandel met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een IJzerhandel in de buurt van Ederveen? Dan ben je bij Technisch Bouwcentrum Ederveen op de juiste plek. Bij Technisch Bouwcentrum Ederveen kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met Technisch Bouwcentrum Ederveendoor ze telefonisch te bereiken op: 31 318 570 443 of bekijk de website door op de link hieronder te klikken.</p>\n<p><a href=\"http://www.bouwcentrumederveen.nl/\" target=\"_blank\" rel=\"nofollow noopener\">http://www.bouwcentrumederveen.nl/</a></p>\n<p>Wil je graag een prettige IJzerhandel? Kom vandaag nog langs bij Technisch Bouwcentrum Ederveen.</p>\n<p>Hoe kom je bij Technisch Bouwcentrum Ederveen? Open direct de <a href=\"https://www.google.com/maps/place/Technisch+Bouwcentrum+Ederveen/@52.060536,5.577859,17z/data=!3m1!4b1!4m6!3m5!1s0x47c64df59c08de3f:0xd9783e29b7bd0fcd!8m2!3d52.060536!4d5.577859!16s%2Fg%2F1tdyvkr7?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je Technisch Bouwcentrum Ederveen het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>Technisch Bouwcentrum Ederveen</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/bmn-bouwmaterialen-hoorn/\">BMN Bouwmaterialen Hoorn</a></li><li><a href=\"/bouwcenter-filippo-beverwijk/\">Bouwcenter Filippo Beverwijk</a></li><li><a href=\"/bouwcenter-logus-de-hoop-terneuzen/\">Bouwcenter Logus-De Hoop Terneuzen</a></li><li><a href=\"/bouwmaat-leiden-xl/\">Bouwmaat Leiden XL</a></li><li><a href=\"/hubo-bouwmarkt-gorredijk/\">Hubo bouwmarkt Gorredijk</a></li><li><a href=\"/praxis-utrecht-city/\">Praxis Utrecht City</a></li><li><a href=\"/tmc-bergen-op-zoom-interieuradvies-pvc-vloeren-en-luxaflex/\">TMC Bergen op Zoom – Interieuradvies, PVC Vloeren en Luxaflex</a></li><li><a href=\"/van-neerbos-bouwmarkten-b-v-/\">Van Neerbos Bouwmarkten B.V.</a></li></ul>"]];
