const segments = [["prose", "<div class=\"store-card\"><div class=\"store-mark\"><img src=\"/img/logo-e60997fc46dbdb.svg\" alt=\"Bouwmaat Groningen XL\" loading=\"lazy\" /></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>Bornholmstraat 38</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31503187000\">+31 50 318 7000</a></dd></div><div><dt>Website</dt><dd><a href=\"https://www.bouwmaat.nl/vestigingen/bouwmaat-groningen\" target=\"_blank\" rel=\"nofollow noopener\">bouwmaat.nl/vestigingen/bouwmaat-groningen</a></dd></div></dl></div>\n<p>Bouwmaat Groningen XL is een Leverancier van bouwmaterialen gelegen aan Bornholmstraat 38 in Groningen.</p>\n<h3 id=\"meer-informatie-over-bouwmaat-groningen-xl-in-groningen\">Meer informatie over Bouwmaat Groningen XL in Groningen</h3>\n<p>Bouwmaat Groningen XL is een Leverancier van bouwmaterialen gelegen in Groningen op Bornholmstraat 38.</p>\n<p>Bouwmaat Groningen XL in Groningen is een grote Leverancier van bouwmaterialen met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een Leverancier van bouwmaterialen in de buurt van Groningen? Dan ben je bij Bouwmaat Groningen XL op de juiste plek. Bij Bouwmaat Groningen XL kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met Bouwmaat Groningen XLdoor ze telefonisch te bereiken op: 31 50 318 7000 of bekijk de website door op de link hieronder te klikken.</p>\n<p><a href=\"https://www.bouwmaat.nl/vestigingen/bouwmaat-groningen?utm_source=Google&amp;utm_medium=GMB&amp;utm_campaign=lokaal&amp;utm_term=vestigingspagina\" target=\"_blank\" rel=\"nofollow noopener\">https://www.bouwmaat.nl/vestigingen/bouwmaat-groningen?utm_source=Google&amp;utm_medium=GMB&amp;utm_campaign=lokaal&amp;utm_term=vestigingspagina</a></p>\n<p>Wil je graag een prettige Leverancier van bouwmaterialen? Kom vandaag nog langs bij Bouwmaat Groningen XL.</p>\n<p>Hoe kom je bij Bouwmaat Groningen XL? Open direct de <a href=\"https://www.google.com/maps/place/Bouwmaat+Groningen+XL/@53.2103872,6.598443,17z/data=!3m1!4b1!4m6!3m5!1s0x47c9d2b4f9f0ac3d:0x7ca0545ba7f47f02!8m2!3d53.2103872!4d6.598443!16s%2Fg%2F1wn_5c37?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je Bouwmaat Groningen XL het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>Bouwmaat Groningen XL</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/bmn-nelemans/\">BMN Nelemans</a></li><li><a href=\"/bouwcenter-concordia-steenwijk/\">Bouwcenter Concordia Steenwijk</a></li><li><a href=\"/bouwmaterialen/\">Bouwmaterialen</a></li><li><a href=\"/gamma-bouwmarkt-gouda/\">GAMMA bouwmarkt Gouda</a></li><li><a href=\"/holtgrefe-waalwijk/\">Holtgrefe Waalwijk</a></li><li><a href=\"/hubo-bouwmarkt-kralingen-rotterdam/\">Hubo bouwmarkt Kralingen Rotterdam</a></li><li><a href=\"/lempens-bouwmaterialen/\">Lempens’ Bouwmaterialen</a></li><li><a href=\"/op-t-hof-wolvega-bv/\">Op ’t Hof Wolvega BV</a></li></ul>"]];
const faq = [];
---
