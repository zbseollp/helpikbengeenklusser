import PageLayout from "../../layouts/PageLayout.astro";
const html = "<div class=\"store-card\"><div class=\"store-mark\"><span class=\"wordmark\">PontMeyer Roosendaal</span></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>Borchwerf 11</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31165536161\">+31 165 536 161</a></dd></div><div><dt>Website</dt><dd><a href=\"https://www.pontmeyer.nl/vestiging/pontmeyer-roosendaal\" target=\"_blank\" rel=\"nofollow noopener\">pontmeyer.nl/vestiging/pontmeyer-roosendaal</a></dd></div></dl></div>\n<p>PontMeyer Roosendaal is een Houthandel gelegen aan Borchwerf 11 in Roosendaal.</p>\n<h3 id=\"meer-informatie-over-pontmeyer-roosendaal-in-roosendaal\">Meer informatie over PontMeyer Roosendaal in Roosendaal</h3>\n<p>PontMeyer Roosendaal is een Houthandel gelegen in Roosendaal op Borchwerf 11.</p>\n<p>PontMeyer Roosendaal in Roosendaal is een grote Houthandel met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een Houthandel in de buurt van Roosendaal? Dan ben je bij PontMeyer Roosendaal op de juiste plek. Bij PontMeyer Roosendaal kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met PontMeyer Roosendaaldoor ze telefonisch te bereiken op: 31 165 536 161 of bekijk de website door op de link hieronder te klikken.</p>\n<p><a href=\"https://www.pontmeyer.nl/vestiging/pontmeyer-roosendaal?utm_source=google-places&amp;utm_medium=organic&amp;utm_campaign=google-places-pontmeyer-roosendaal\" target=\"_blank\" rel=\"nofollow noopener\">https://www.pontmeyer.nl/vestiging/pontmeyer-roosendaal?utm_source=google-places&amp;utm_medium=organic&amp;utm_campaign=google-places-pontmeyer-roosendaal</a></p>\n<p>Wil je graag een prettige Houthandel? Kom vandaag nog langs bij PontMeyer Roosendaal.</p>\n<p>Hoe kom je bij PontMeyer Roosendaal? Open direct de <a href=\"https://www.google.com/maps/place/PontMeyer+Roosendaal/@51.543702,4.457945,17z/data=!3m1!4b1!4m6!3m5!1s0x47c416e546bebef3:0xd13fcf879720c440!8m2!3d51.543702!4d4.457945!16s%2Fg%2F1tczpjkf?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je PontMeyer Roosendaal het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>PontMeyer Roosendaal</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/bouwcenter-nieuwegein/\">Bouwcenter Nieuwegein</a></li><li><a href=\"/de-lange-doe-het-zelf-verf-en-wonen/\">De Lange doe het zelf- verf en wonen</a></li><li><a href=\"/karwei-bouwmarkt-bergen-op-zoom/\">Karwei bouwmarkt Bergen op Zoom</a></li><li><a href=\"/multimate-kaatsheuvel/\">Multimate Kaatsheuvel</a></li><li><a href=\"/pontmeyer-emmeloord/\">PontMeyer Emmeloord</a></li><li><a href=\"/praxis-bouwmarkt-dordrecht/\">Praxis Bouwmarkt Dordrecht</a></li><li><a href=\"/technisch-bouwcentrum-ederveen/\">Technisch Bouwcentrum Ederveen</a></li><li><a href=\"/wanco-doe-het-zelf-b-v-/\">Wanco Doe Het Zelf B.V.</a></li></ul>";
