const segments = [["prose", "<div class=\"store-card\"><div class=\"store-mark\"><img src=\"/img/logo-e60997fc46dbdb.svg\" alt=\"Bouwmaat Amstelveen\" loading=\"lazy\" /></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>Aalsmeerderweg 463</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31206560250\">+31 20 656 0250</a></dd></div><div><dt>Website</dt><dd><a href=\"https://www.bouwmaat.nl/vestigingen/bouwmaat-amstelveen\" target=\"_blank\" rel=\"nofollow noopener\">bouwmaat.nl/vestigingen/bouwmaat-amstelveen</a></dd></div></dl></div>\n<p>Bouwmaat Amstelveen is een Leverancier van bouwmaterialen gelegen aan Aalsmeerderweg 463 in Aalsmeer.</p>\n<h3 id=\"meer-informatie-over-bouwmaat-amstelveen-in-aalsmeer\">Meer informatie over Bouwmaat Amstelveen in Aalsmeer</h3>\n<p>Bouwmaat Amstelveen is een Leverancier van bouwmaterialen gelegen in Aalsmeer op Aalsmeerderweg 463.</p>\n<p>Bouwmaat Amstelveen in Aalsmeer is een grote Leverancier van bouwmaterialen met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een Leverancier van bouwmaterialen in de buurt van Aalsmeer? Dan ben je bij Bouwmaat Amstelveen op de juiste plek. Bij Bouwmaat Amstelveen kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met Bouwmaat Amstelveendoor ze telefonisch te bereiken op: 31 20 656 0250 of bekijk de website door op de link hieronder te klikken.</p>\n<p><a href=\"https://www.bouwmaat.nl/vestigingen/bouwmaat-amstelveen?utm_source=Google&amp;utm_medium=GMB&amp;utm_campaign=lokaal&amp;utm_term=vestigingspagina\" target=\"_blank\" rel=\"nofollow noopener\">https://www.bouwmaat.nl/vestigingen/bouwmaat-amstelveen?utm_source=Google&amp;utm_medium=GMB&amp;utm_campaign=lokaal&amp;utm_term=vestigingspagina</a></p>\n<p>Wil je graag een prettige Leverancier van bouwmaterialen? Kom vandaag nog langs bij Bouwmaat Amstelveen.</p>\n<p>Hoe kom je bij Bouwmaat Amstelveen? Open direct de <a href=\"https://www.google.com/maps/place/Bouwmaat+Amstelveen/@52.2892202,4.8183504,17z/data=!3m1!4b1!4m6!3m5!1s0x47c5e043c0ea6d0b:0x1c4e3a08f872b84e!8m2!3d52.2892202!4d4.8183504!16s%2Fg%2F1tg2jw47?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je Bouwmaat Amstelveen het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>Bouwmaat Amstelveen</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/bouwmaat-leeuwarden/\">Bouwmaat Leeuwarden</a></li><li><a href=\"/gamma-bouwmarkt-hellevoetsluis/\">GAMMA bouwmarkt Hellevoetsluis</a></li><li><a href=\"/hubo-xl-bouwmarkt-homed-ijsselstein/\">Hubo XL bouwmarkt &amp; Homed IJsselstein</a></li><li><a href=\"/hubo-bouwmarkt-goor/\">Hubo bouwmarkt Goor</a></li><li><a href=\"/karwei-bouwmarkt-bodegraven/\">Karwei bouwmarkt Bodegraven</a></li><li><a href=\"/online-bouwmaterialen-nl/\">Online-Bouwmaterialen.nl</a></li><li><a href=\"/praxis-bouwmarkt/\">Praxis Bouwmarkt</a></li><li><a href=\"/praxis-bouwmarkt-hippolytushoef/\">Praxis Bouwmarkt Hippolytushoef</a></li></ul>"]];
const faq = [];
