import PageLayout from "../../layouts/PageLayout.astro";
const segments = [["prose", "<div class=\"store-card\"><div class=\"store-mark\"><span class=\"wordmark\">GAMMA bouwmarkt Hoofddorp</span></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>Noordmeerstraat 22</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31235657656\">+31 23 565 7656</a></dd></div><div><dt>Website</dt><dd><a href=\"https://www.gamma.nl/bouwmarkten/hoofddorp\" target=\"_blank\" rel=\"nofollow noopener\">gamma.nl/bouwmarkten/hoofddorp</a></dd></div></dl></div>\n<p>GAMMA bouwmarkt Hoofddorp is een Leverancier van bouwmaterialen gelegen aan Noordmeerstraat 22 in Hoofddorp.</p>\n<h3 id=\"meer-informatie-over-gamma-bouwmarkt-hoofddorp-in-hoofddorp\">Meer informatie over GAMMA bouwmarkt Hoofddorp in Hoofddorp</h3>\n<p>GAMMA bouwmarkt Hoofddorp is een Leverancier van bouwmaterialen gelegen in Hoofddorp op Noordmeerstraat 22.</p>\n<p>GAMMA bouwmarkt Hoofddorp in Hoofddorp is een grote Leverancier van bouwmaterialen met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een Leverancier van bouwmaterialen in de buurt van Hoofddorp? Dan ben je bij GAMMA bouwmarkt Hoofddorp op de juiste plek. Bij GAMMA bouwmarkt Hoofddorp kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met GAMMA bouwmarkt Hoofddorpdoor ze telefonisch te bereiken op: 31 23 565 7656 of bekijk de website door op de link hieronder te klikken.</p>\n<p><a href=\"https://www.gamma.nl/bouwmarkten/hoofddorp?utm_campaign=gmb&amp;utm_medium=organic&amp;utm_source=google\" target=\"_blank\" rel=\"nofollow noopener\">https://www.gamma.nl/bouwmarkten/hoofddorp?utm_campaign=gmb&amp;utm_medium=organic&amp;utm_source=google</a></p>\n<p>Wil je graag een prettige Leverancier van bouwmaterialen? Kom vandaag nog langs bij GAMMA bouwmarkt Hoofddorp.</p>\n<p>Hoe kom je bij GAMMA bouwmarkt Hoofddorp? Open direct de <a href=\"https://www.google.com/maps/place/GAMMA+bouwmarkt+Hoofddorp/@52.3145953,4.6967284,17z/data=!3m1!4b1!4m6!3m5!1s0x47c5e655b5270c2f:0x498b0e7a7d9ef838!8m2!3d52.3145953!4d4.6967284!16s%2Fg%2F1hc7jv0l6?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je GAMMA bouwmarkt Hoofddorp het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>GAMMA bouwmarkt Hoofddorp</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/bouw-handel-nl/\">Bouw-Handel.nl</a></li><li><a href=\"/de-ruiter-bouwmaterialenhandel-b-v-/\">De Ruiter Bouwmaterialenhandel B.V.</a></li><li><a href=\"/gamma-bouwmarkt-veenendaal/\">GAMMA bouwmarkt Veenendaal</a></li><li><a href=\"/hornbach/\">HORNBACH</a></li><li><a href=\"/hornbach-best/\">HORNBACH Best</a></li><li><a href=\"/karwei-bouwmarkt-bergen-op-zoom/\">Karwei bouwmarkt Bergen op Zoom</a></li><li><a href=\"/karwei-bouwmarkt-breda-oost/\">Karwei bouwmarkt Breda-Oost</a></li><li><a href=\"/karwei-bouwmarkt-maassluis/\">Karwei bouwmarkt Maassluis</a></li></ul>"]];
