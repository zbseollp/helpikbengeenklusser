---
import PageLayout from "../../layouts/PageLayout.astro";
const segments = [["prose", "<div class=\"store-card\"><div class=\"store-mark\"><span class=\"wordmark\">PontMeyer Drachten</span></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>De Gaffel 44</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31512522000\">+31 512 522 000</a></dd></div><div><dt>Website</dt><dd><a href=\"https://www.pontmeyer.nl/vestiging/pontmeyer-drachten\" target=\"_blank\" rel=\"nofollow noopener\">pontmeyer.nl/vestiging/pontmeyer-drachten</a></dd></div></dl></div>\n<p>PontMeyer Drachten is een Houthandel gelegen aan De Gaffel 44 in Drachten.</p>\n<h3 id=\"meer-informatie-over-pontmeyer-drachten-in-drachten\">Meer informatie over PontMeyer Drachten in Drachten</h3>\n<p>PontMeyer Drachten is een Houthandel gelegen in Drachten op De Gaffel 44.</p>\n<p>PontMeyer Drachten in Drachten is een grote Houthandel met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een Houthandel in de buurt van Drachten? Dan ben je bij PontMeyer Drachten op de juiste plek. Bij PontMeyer Drachten kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met PontMeyer Drachtendoor ze telefonisch te bereiken op: 31 512 522 000 of bekijk de website door op de link hieronder te klikken.</p>\n<p><a href=\"https://www.pontmeyer.nl/vestiging/pontmeyer-drachten?utm_source=google-places&amp;utm_medium=organic&amp;utm_campaign=google-places-pontmeyer-drachten\" target=\"_blank\" rel=\"nofollow noopener\">https://www.pontmeyer.nl/vestiging/pontmeyer-drachten?utm_source=google-places&amp;utm_medium=organic&amp;utm_campaign=google-places-pontmeyer-drachten</a></p>\n<p>Wil je graag een prettige Houthandel? Kom vandaag nog langs bij PontMeyer Drachten.</p>\n<p>Hoe kom je bij PontMeyer Drachten? Open direct de <a href=\"https://www.google.com/maps/place/PontMeyer+Drachten/@53.1157276,6.0733922,17z/data=!3m1!4b1!4m6!3m5!1s0x47c851b70af2d93d:0x8a8835371571d760!8m2!3d53.1157276!4d6.0733922!16s%2Fg%2F1tls22j3?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je PontMeyer Drachten het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>PontMeyer Drachten</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/bmn-bouwmaterialen-winschoten/\">BMN Bouwmaterialen Winschoten</a></li><li><a href=\"/bouwcenter-koolschijn/\">Bouwcenter Koolschijn</a></li><li><a href=\"/hubo-bouwmarkt-serooskerke/\">Hubo bouwmarkt Serooskerke</a></li><li><a href=\"/hubo-bouwmarkt-van-hees-breda/\">Hubo bouwmarkt Van Hees Breda</a></li><li><a href=\"/karwei-bouwmarkt-hoofddorp/\">Karwei bouwmarkt Hoofddorp</a></li><li><a href=\"/karwei-bouwmarkt-schijndel/\">Karwei bouwmarkt Schijndel</a></li><li><a href=\"/raab-karcher-zwolle/\">Raab Karcher Zwolle</a></li><li><a href=\"/van-neerbos-bouwmarkten/\">Van Neerbos Bouwmarkten</a></li></ul>"]];
const faq = [];
