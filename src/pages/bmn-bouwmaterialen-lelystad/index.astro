const segments = [["prose", "<div class=\"store-card\"><div class=\"store-mark\"><span class=\"wordmark\">BMN Bouwmaterialen Lelystad</span></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>Binnenhavenweg 37</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31320239000\">+31 320 239 000</a></dd></div><div><dt>Website</dt><dd><a href=\"https://www.bmn.nl/\" target=\"_blank\" rel=\"nofollow noopener\">bmn.nl</a></dd></div></dl></div>\n<p>BMN Bouwmaterialen Lelystad is een Leverancier van bouwmaterialen gelegen aan Binnenhavenweg 37 in Lelystad.</p>\n<h3 id=\"meer-informatie-over-bmn-bouwmaterialen-lelystad-in-lelystad\">Meer informatie over BMN Bouwmaterialen Lelystad in Lelystad</h3>\n<p>BMN Bouwmaterialen Lelystad is een Leverancier van bouwmaterialen gelegen in Lelystad op Binnenhavenweg 37.</p>\n<p>BMN Bouwmaterialen Lelystad in Lelystad is een grote Leverancier van bouwmaterialen met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een Leverancier van bouwmaterialen in de buurt van Lelystad? Dan ben je bij BMN Bouwmaterialen Lelystad op de juiste plek. Bij BMN Bouwmaterialen Lelystad kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met BMN Bouwmaterialen Lelystaddoor ze telefonisch te bereiken op: 31 320 239 000 of bekijk de website door op de link hieronder te klikken.</p>\n<p><a href=\"https://www.bmn.nl/\" target=\"_blank\" rel=\"nofollow noopener\">https://www.bmn.nl/</a></p>\n<p>Wil je graag een prettige Leverancier van bouwmaterialen? Kom vandaag nog langs bij BMN Bouwmaterialen Lelystad.</p>\n<p>Hoe kom je bij BMN Bouwmaterialen Lelystad? Open direct de <a href=\"https://www.google.com/maps/place/Bouwwinkel/@52.5384483,5.5200668,17z/data=!3m1!4b1!4m2!3m1!1s0x47c627c90972161d:0xc586bea09913cc08?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je BMN Bouwmaterialen Lelystad het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>BMN Bouwmaterialen Lelystad</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/bmn-bouwmaterialen-harderwijk/\">BMN Bouwmaterialen Harderwijk</a></li><li><a href=\"/bouwhof-bezig-met-je-huis-/\">Bouwhof – Bezig met je huis.</a></li><li><a href=\"/de-bouwwinkel/\">De Bouwwinkel</a></li><li><a href=\"/enorm-stevens/\">Enorm Stevens</a></li><li><a href=\"/karwei-bouwmarkt-kampen/\">Karwei bouwmarkt Kampen</a></li><li><a href=\"/karwei-bouwmarkt-landgraaf/\">Karwei bouwmarkt Landgraaf</a></li><li><a href=\"/karwei-bouwmarkt-leeuwarden/\">Karwei bouwmarkt Leeuwarden</a></li><li><a href=\"/praxis-bouwmarkt-beverwijk/\">Praxis Bouwmarkt Beverwijk</a></li></ul>"]];
const faq = [];
