import PageLayout from "../../layouts/PageLayout.astro";
const segments = [["prose", "<div class=\"store-card\"><div class=\"store-mark\"><img src=\"/img/logo-24b41efc5e54f8.svg\" alt=\"Toolstation Breda\" loading=\"lazy\" /></div><dl class=\"store-facts\"><div><dt>Adres</dt><dd>Spinveld 17</dd></div><div><dt>Telefoon</dt><dd><a href=\"tel:+31715815050\">+31 71 581 5050</a></dd></div><div><dt>Website</dt><dd><a href=\"https://www.toolstation.nl/\" target=\"_blank\" rel=\"nofollow noopener\">toolstation.nl</a></dd></div></dl></div>\n<p>Toolstation Breda is een Bouwmarkt gelegen aan Spinveld 17 in Breda.</p>\n<h3 id=\"meer-informatie-over-toolstation-breda-in-breda\">Meer informatie over Toolstation Breda in Breda</h3>\n<p>Toolstation Breda is een Bouwmarkt gelegen in Breda op Spinveld 17.</p>\n<p>Toolstation Breda in Breda is een grote Bouwmarkt met een grote voorraad in het magazijn, zodat ze altijd alles in huis hebben.</p>\n<p>Ben jij opzoek naar een Bouwmarkt in de buurt van Breda? Dan ben je bij Toolstation Breda op de juiste plek. Bij Toolstation Breda kan je altijd terecht voor schroefjes, hout, een cirkelzaag en noem zo maar op.</p>\n<p>Je kan contact opnemen met Toolstation Bredadoor ze telefonisch te bereiken op: 31 71 581 5050 of bekijk de website door op de link hieronder te klikken.</p>\n<p><a href=\"https://www.toolstation.nl/?utm_source=Local&amp;utm_campaign=MyBusiness_AP&amp;utm_medium=Organic&amp;utm_term=all&amp;utm_content=Breda&amp;y_source=1_OTI0ODI2NTEtNzE1LWxvY2F0aW9uLndlYnNpdGU%3D\" target=\"_blank\" rel=\"nofollow noopener\">https://www.toolstation.nl/?utm_source=Local&amp;utm_campaign=MyBusiness_AP&amp;utm_medium=Organic&amp;utm_term=all&amp;utm_content=Breda&amp;y_source=1_OTI0ODI2NTEtNzE1LWxvY2F0aW9uLndlYnNpdGU%3D</a></p>\n<p>Wil je graag een prettige Bouwmarkt? Kom vandaag nog langs bij Toolstation Breda.</p>\n<p>Hoe kom je bij Toolstation Breda? Open direct de <a href=\"https://www.google.com/maps/place/Toolstation+Breda/@51.600164,4.758346,17z/data=!3m1!4b1!4m6!3m5!1s0x47c69fed03cddc77:0xea92ab04b84e2695!8m2!3d51.600164!4d4.758346!16s%2Fg%2F11gbf9lgj2?hl=nl\" target=\"_blank\" rel=\"nofollow noopener\">routebeschrijving</a>. Zo zie je direct hoe je Toolstation Breda het makkelijkste kan bereiken met de auto, fiets of het openbaar vervoer.</p>\n<ol><li><a href=\"/bouwwinkel/\">Bouwwinkel</a></li><li>Toolstation Breda</li></ol>\n<h4 id=\"bezoekers-bekeken-ook\">Bezoekers bekeken ook</h4>\n<ul><li><a href=\"/bouwcenter-logus-de-hoop-rotterdam-noord/\">Bouwcenter Logus-De Hoop Rotterdam-Noord</a></li><li><a href=\"/bouwshop-kloosterhaar/\">Bouwshop Kloosterhaar</a></li><li><a href=\"/gamma-bouwmarkt-doemere-almere/\">GAMMA bouwmarkt Doemere, Almere</a></li><li><a href=\"/grottendieck-bezuidenhout/\">Grottendieck Bezuidenhout</a></li><li><a href=\"/hubo-hengelo-torenlaan/\">Hubo Hengelo Torenlaan</a></li><li><a href=\"/hubo-bouwmarkt-baarle-nassau/\">Hubo bouwmarkt Baarle-Nassau</a></li><li><a href=\"/multimate-kaatsheuvel/\">Multimate Kaatsheuvel</a></li><li><a href=\"/pontmeyer-gorinchem/\">PontMeyer Gorinchem</a></li></ul>"]];
const faq = [];
---
